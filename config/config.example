# battery-notify configuration.
#
# Copy to ~/.config/battery-notify/config and edit; then restart the service:
#   systemctl --user restart battery-notify.service
# The file replaces these defaults entirely. See "man battery-notify".
#
# Each section is an event:
#   [discharging N]   on battery, the level drops to N% or below
#   [charging N]      on AC, the level rises to N% or above
#   [full]            UPower reports "fully charged"
#   [plugged]         the charger is connected
#   [unplugged]       the charger is disconnected
#   [show discharging], [show charging], [show full]
#                     "battery-notify show", by state
# Keys: title (required), message, urgency (low, normal, critical; default
# normal), timeout (milliseconds; default 2000, 0 for critical: stays until
# dismissed). Placeholders: {level} (percentage), {time} (time left, as 3h 36m).

[show discharging]
title = Battery {level}%
message = {time} remaining

[show charging]
title = Battery {level}%
message = {time} to full

[show full]
title = Battery Full
message = Battery {level}%

[plugged]
title = Charger connected
message = Battery {level}% · {time} to full

[unplugged]
title = Charger disconnected
message = Battery {level}% · {time} remaining

[full]
title = Battery Full
message = Battery {level}%

[discharging 90]
title = Battery {level}%
message = {time} remaining

[discharging 80]
title = Battery {level}%
message = {time} remaining

[discharging 70]
title = Battery {level}%
message = {time} remaining

[discharging 60]
title = Battery {level}%
message = {time} remaining

[discharging 50]
title = Battery {level}%
message = {time} remaining

[discharging 40]
title = Battery {level}%
message = {time} remaining

[discharging 30]
title = Battery {level}%
message = {time} remaining

[discharging 20]
title = Battery {level}%
message = {time} remaining

[discharging 15]
urgency = critical
title = Battery low
message = Connect the charger: {level}% left

[discharging 10]
urgency = critical
title = Battery low
message = Connect the charger: {level}% left

[discharging 5]
urgency = critical
title = Battery critical
message = Connect the charger now: {level}% left

[charging 5]
title = Battery {level}%
message = {time} to full

[charging 10]
title = Battery {level}%
message = {time} to full

[charging 15]
title = Battery {level}%
message = {time} to full

[charging 20]
title = Battery {level}%
message = {time} to full

[charging 30]
title = Battery {level}%
message = {time} to full

[charging 40]
title = Battery {level}%
message = {time} to full

[charging 50]
title = Battery {level}%
message = {time} to full

[charging 60]
title = Battery {level}%
message = {time} to full

[charging 70]
title = Battery {level}%
message = {time} to full

[charging 80]
title = Battery {level}%
message = {time} to full

[charging 90]
title = Battery {level}%
message = {time} to full
