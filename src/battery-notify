# --- values: configuration ---------------------------------------------------

# is_event NAME: succeeds if NAME is a config section name.
is_event() {
    [[ "$1" =~ ^(discharging|charging)\ ([1-9][0-9]?|100)$ ||
        "$1" =~ ^(full|plugged|unplugged)$ ||
        "$1" =~ ^show\ (discharging|charging|full)$ ]]
}

# check_text LINE KEY VALUE
# Succeeds if VALUE is a valid title or message. Otherwise prints the problem
# as "LINE: problem".
check_text() {
    local -r line="$1" key="$2" value="$3"
    if [[ "$value" == *"$SEP"* ]]; then
        printf '%s: invalid character in %s\n' "$line" "$key"
        return 1
    fi
    local rest="$value" placeholder
    while [[ "$rest" =~ \{[^{}]*\} ]]; do
        placeholder="${BASH_REMATCH[0]}"
        if [[ "$placeholder" != "{level}" && "$placeholder" != "{time}" ]]; then
            printf "%s: unknown placeholder '%s': expected {level} or {time}\n" "$line" "$placeholder"
            return 1
        fi
        rest="${rest#*"$placeholder"}"
    done
}

# config_rule OUT LINE EVENT TITLE MESSAGE URGENCY TIMEOUT
# The rule of a finished section, with defaults filled in. Returns in OUT.
# Fails, with "LINE: problem" in OUT, if the section has no title.
# shellcheck disable=SC2034 # assigning to the nameref `out` is the return value
config_rule() {
    local -n out="$1"
    local -r line="$2" event="$3" title="$4" message="$5" urgency="${6:-normal}"
    local timeout="$7"
    if [[ -z "$title" ]]; then
        out="$line: section [$event] has no title"
        return 1
    fi
    if [[ -z "$timeout" ]]; then
        if [[ "$urgency" == critical ]]; then timeout=0; else timeout=2000; fi
    fi
    out="$event$SEP$urgency$SEP$timeout$SEP$title$SEP$message"
}

# parse_config TEXT
# Parse a configuration. Prints one rule per section, in file order:
# EVENT SEP URGENCY SEP TIMEOUT SEP TITLE SEP MESSAGE. On the first mistake,
# prints "LINE: problem" instead and fails.
parse_config() {
    local line key value lineno=0 rule
    local event="" event_line=0 title="" message="" urgency="" timeout=""
    local keys=" " sections=" "
    local -a parsed=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        if [[ -z "$line" || "$line" == \#* ]]; then
            continue
        fi

        if [[ "$line" =~ ^\[(.*)\]$ ]]; then
            if [[ -n "$event" ]]; then
                config_rule rule "$event_line" "$event" "$title" "$message" "$urgency" "$timeout" || {
                    printf '%s\n' "$rule"
                    return 1
                }
                parsed+=("$rule")
            fi
            event="${BASH_REMATCH[1]}"
            if ! is_event "$event"; then
                printf "%s: unknown event '%s'\n" "$lineno" "$event"
                return 1
            fi
            if [[ "$sections" == *" [$event] "* ]]; then
                printf '%s: duplicate section [%s]\n' "$lineno" "$event"
                return 1
            fi
            sections+="[$event] "
            event_line="$lineno" title="" message="" urgency="" timeout="" keys=" "

        elif [[ "$line" =~ ^([a-z]+)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
            key="${BASH_REMATCH[1]}" value="${BASH_REMATCH[2]}"
            if [[ -z "$event" ]]; then
                printf "%s: '%s' is outside a section\n" "$lineno" "$key"
                return 1
            fi
            if [[ "$keys" == *" $key "* ]]; then
                printf "%s: duplicate key '%s'\n" "$lineno" "$key"
                return 1
            fi
            keys+="$key "
            case "$key" in
            title)
                if [[ -z "$value" ]]; then
                    printf '%s: empty title\n' "$lineno"
                    return 1
                fi
                check_text "$lineno" title "$value" || return 1
                title="$value"
                ;;
            message)
                check_text "$lineno" message "$value" || return 1
                message="$value"
                ;;
            urgency)
                if [[ ! "$value" =~ ^(low|normal|critical)$ ]]; then
                    printf "%s: invalid urgency '%s': expected low, normal or critical\n" "$lineno" "$value"
                    return 1
                fi
                urgency="$value"
                ;;
            timeout)
                if [[ ! "$value" =~ ^(0|[1-9][0-9]{0,6})$ ]]; then
                    printf "%s: invalid timeout '%s': expected milliseconds from 0 to 9999999\n" "$lineno" "$value"
                    return 1
                fi
                timeout="$value"
                ;;
            *)
                printf "%s: unknown key '%s'\n" "$lineno" "$key"
                return 1
                ;;
            esac

        else
            printf "%s: expected '[event]' or 'key = value'\n" "$lineno"
            return 1
        fi
    done <<<"$1"

    if [[ -n "$event" ]]; then
        config_rule rule "$event_line" "$event" "$title" "$message" "$urgency" "$timeout" || {
            printf '%s\n' "$rule"
            return 1
        }
        parsed+=("$rule")
    fi
    if ((${#parsed[@]} > 0)); then
        printf '%s\n' "${parsed[@]}"
    fi
}

# rule_for EVENT RULES: print EVENT's rule; fails if it has none.
rule_for() {
    local -r event="$1"
    local rule
    while IFS= read -r rule; do
        if [[ "${rule%%"$SEP"*}" == "$event" ]]; then
            printf '%s\n' "$rule"
            return 0
        fi
    done <<<"$2"
    return 1
}

# levels_of KIND RULES: print the levels of the "KIND N" rules, one per line.
levels_of() {
    local -r kind="$1"
    local rule event
    while IFS= read -r rule; do
        event="${rule%%"$SEP"*}"
        if [[ "$event" == "$kind "* ]]; then
            printf '%s\n' "${event#"$kind "}"
        fi
    done <<<"$2"
}

# fill_placeholders TEXT LEVEL TIME
fill_placeholders() {
    local text="$1"
    # Quoted replacements are literal (no `&` expansion in Bash 5.2+).
    text="${text//"{level}"/"$2"}"
    text="${text//"{time}"/"$3"}"
    printf '%s\n' "$text"
}

# render_rule RULE LEVEL TIME
# Print what to notify: URGENCY SEP TIMEOUT SEP TITLE SEP MESSAGE.
render_rule() {
    local event urgency timeout title message
    IFS="$SEP" read -r event urgency timeout title message <<<"$1"
    printf '%s\n' "$urgency$SEP$timeout$SEP$(fill_placeholders "$title" "$2" "$3")$SEP$(fill_placeholders "$message" "$2" "$3")"
}

# --- values: battery ---------------------------------------------------------

# state_name CODE: UPower's Device.State number as a name.
state_name() {
    case "$1" in
    0) printf 'unknown\n' ;;
    1) printf 'charging\n' ;;
    2) printf 'discharging\n' ;;
    3) printf 'empty\n' ;;
    4) printf 'full\n' ;;
    5) printf 'pending-charge\n' ;;
    6) printf 'pending-discharge\n' ;;
    *) return 1 ;;
    esac
}

# power_source STATE: "ac", "battery" or "unknown".
# pending-charge is on AC but not charging, e.g. held at a charge limit.
power_source() {
    case "$1" in
    charging | full | pending-charge) printf 'ac\n' ;;
    discharging | empty | pending-discharge) printf 'battery\n' ;;
    *) printf 'unknown\n' ;;
    esac
}

# time_for STATE TIME_TO_EMPTY TIME_TO_FULL: the seconds {time} refers to:
# to empty on battery, to full while charging, else 0 (none).
time_for() {
    case "$1" in
    discharging | empty | pending-discharge) printf '%s\n' "$2" ;;
    charging) printf '%s\n' "$3" ;;
    *) printf '0\n' ;;
    esac
}

# format_time SECONDS: "h:mm", or "unknown" for 0 (UPower still estimating).
format_time() {
    local -r seconds="$1"
    if ((seconds == 0)); then
        printf 'unknown\n'
    else
        printf '%d:%02d\n' $((seconds / 3600)) $((seconds % 3600 / 60))
    fi
}

# format_status STATE PERCENTAGE TIME_TO_EMPTY TIME_TO_FULL
format_status() {
    printf '%s\n' \
        "state=$1" \
        "percentage=$2" \
        "time_to_empty=$3" \
        "time_to_full=$4"
}

# show_event STATE: the event `battery-notify show` uses in this state.
show_event() {
    case "$1" in
    charging | pending-charge) printf 'show charging\n' ;;
    full) printf 'show full\n' ;;
    *) printf 'show discharging\n' ;;
    esac
}

# decide_events PREV_STATE PREV_PERCENTAGE STATE PERCENTAGE RULES
# Print the events that fire between two readings, one per line, in order:
# plugged/unplugged, then a level, then full. Only events with a rule fire.
#   - discharging N: on battery, the percentage drops across N;
#   - charging N: on AC, the percentage rises across N;
#   - across several levels at once, only the most severe fires (the lowest
#     discharging level, the highest charging level).
decide_events() {
    local -r prev_state="$1" prev="$2" state="$3" percent="$4" rules="$5"
    local from to level best="" event
    from="$(power_source "$prev_state")"
    to="$(power_source "$state")"
    local -a events=()

    if [[ "$from" == battery && "$to" == ac ]]; then
        events+=(plugged)
    elif [[ "$from" == ac && "$to" == battery ]]; then
        events+=(unplugged)
    fi

    if [[ "$to" == battery ]]; then
        for level in $(levels_of discharging "$rules"); do
            if ((prev > level && level >= percent)) && [[ -z "$best" || "$level" -lt "$best" ]]; then
                best="$level"
            fi
        done
        [[ -z "$best" ]] || events+=("discharging $best")
    elif [[ "$to" == ac ]]; then
        for level in $(levels_of charging "$rules"); do
            if ((prev < level && level <= percent)) && [[ -z "$best" || "$level" -gt "$best" ]]; then
                best="$level"
            fi
        done
        [[ -z "$best" ]] || events+=("charging $best")
    fi

    if [[ "$state" == full && "$prev_state" != full ]]; then
        events+=(full)
    fi

    for event in "${events[@]}"; do
        if rule_for "$event" "$rules" >/dev/null; then
            printf '%s\n' "$event"
        fi
    done
}

# rule_urgency RULE: the urgency field of a rule.
rule_urgency() {
    local event urgency rest
    IFS="$SEP" read -r event urgency rest <<<"$1"
    printf '%s\n' "$urgency"
}

# startup_events STATE PERCENTAGE RULES
# At daemon start: on battery at or below a *critical* discharging level, the
# nearest one. Other levels (e.g. status every 10%) stay quiet, or every login
# on battery would notify.
startup_events() {
    local -r state="$1" percent="$2" rules="$3"
    local level best="" rule
    [[ "$(power_source "$state")" == battery ]] || return 0
    for level in $(levels_of discharging "$rules"); do
        if ((level >= percent)) && [[ -z "$best" || "$level" -lt "$best" ]]; then
            rule="$(rule_for "discharging $level" "$rules")"
            if [[ "$(rule_urgency "$rule")" == critical ]]; then
                best="$level"
            fi
        fi
    done
    [[ -z "$best" ]] || printf 'discharging %s\n' "$best"
}

# parse_battery TEXT
# Parse busctl's answer for UPOWER_PROPERTIES. Prints "STATE PERCENTAGE
# TIME_TO_EMPTY TIME_TO_FULL", with the percentage rounded down. Fails (1) if
# the answer is malformed, and (2) if the device is not a present battery.
parse_battery() {
    local -a lines
    mapfile -t lines <<<"$1"
    ((${#lines[@]} == 6)) || return 1
    local -r time_re='^x (0|[1-9][0-9]{0,11})$'
    [[ "${lines[0]}" =~ ^b\ (true|false)$ ]] || return 1
    local -r present="${BASH_REMATCH[1]}"
    [[ "${lines[1]}" =~ ^u\ ([0-9]+)$ ]] || return 1
    local -r type="${BASH_REMATCH[1]}"
    [[ "${lines[2]}" =~ ^u\ ([0-9])$ ]] || return 1
    local state
    state="$(state_name "${BASH_REMATCH[1]}")" || return 1
    [[ "${lines[3]}" =~ ^d\ (0|[1-9][0-9]{0,2})(\.[0-9]+)?$ ]] || return 1
    local -r percent="${BASH_REMATCH[1]}"
    ((percent <= 100)) || return 1
    [[ "${lines[4]}" =~ $time_re ]] || return 1
    local -r to_empty="${BASH_REMATCH[1]}"
    [[ "${lines[5]}" =~ $time_re ]] || return 1
    local -r to_full="${BASH_REMATCH[1]}"
    # UPower's Device.Type 2 is a battery.
    [[ "$present" == true && "$type" == 2 ]] || return 2
    printf '%s %s %s %s\n' "$state" "$percent" "$to_empty" "$to_full"
}

# --- system ------------------------------------------------------------------

# err MESSAGE: print an error message to stderr.
err() {
    printf 'battery-notify: %s\n' "$1" >&2
}

# sys_config_path: the config file's path, following the XDG specification
# (XDG_CONFIG_HOME if set and absolute, else ~/.config). It may not exist.
sys_config_path() {
    local dir="${XDG_CONFIG_HOME-}"
    [[ "$dir" == /* ]] || dir="$HOME/.config"
    printf '%s\n' "$dir/battery-notify/config"
}

# sys_load_rules
# Print the parsed rules of the user's config file, or of DEFAULT_CONFIG when
# there is none. Reports a config mistake as FILE:LINE: problem.
sys_load_rules() {
    local path text rules
    path="$(sys_config_path)"
    if [[ ! -e "$path" ]]; then
        parse_config "$DEFAULT_CONFIG"
        return
    fi
    if [[ ! -f "$path" || ! -r "$path" ]] || ! text="$(<"$path")"; then
        err "cannot read $path"
        return "$EXIT_SYSTEM"
    fi
    rules="$(parse_config "$text")" || {
        err "$path:$rules"
        return "$EXIT_CONFIG"
    }
    printf '%s\n' "$rules"
}

# sys_rule_for EVENT RULES
# Print EVENT's rule; reports a config mistake if the config has none.
sys_rule_for() {
    rule_for "$1" "$2" || {
        err "$(sys_config_path): no [$1] section"
        return "$EXIT_CONFIG"
    }
}

# sys_read_battery
# Print "STATE PERCENTAGE TIME_TO_EMPTY TIME_TO_FULL" from UPower.
sys_read_battery() {
    local answer battery
    answer="$(busctl --system get-property org.freedesktop.UPower "$UPOWER_DEVICE" \
        org.freedesktop.UPower.Device "${UPOWER_PROPERTIES[@]}")" || {
        err "could not read the battery from UPower"
        return "$EXIT_SYSTEM"
    }
    battery="$(parse_battery "$answer")" || {
        if (($? == 2)); then
            err "no battery found"
            return "$EXIT_NO_BATTERY"
        fi
        err "unexpected answer from UPower"
        return "$EXIT_SYSTEM"
    }
    printf '%s\n' "$battery"
}

# sys_notify URGENCY EXPIRE_MS TITLE BODY
sys_notify() {
    notify-send --app-name=battery-notify --urgency="$1" --expire-time="$2" "$3" "$4" || {
        err "could not send a notification"
        return "$EXIT_SYSTEM"
    }
}

# sys_notify_config_error
# Notify the config mistake (once), for the daemon, whose stderr nobody sees.
sys_notify_config_error() {
    local problem
    problem="$(sys_load_rules 2>&1 >/dev/null)"
    sys_notify critical 0 "battery-notify: config error" "${problem#battery-notify: }"
}

# sys_monitor_open FD_VAR PID_VAR
# Start watching UPower's display device for changes. Returns the stream's file
# descriptor in FD_VAR and the watcher's PID in PID_VAR (a nameref, so the
# descriptor stays open in the calling shell). Its own locals start with
# `monitor_`, so they can't shadow the caller's variables.
# shellcheck disable=SC2034 # assigning to the namerefs is the return value
sys_monitor_open() {
    local -n monitor_fd_out="$1" monitor_pid_out="$2"
    local monitor_fd
    exec {monitor_fd}< <(exec gdbus monitor --system --dest org.freedesktop.UPower --object-path "$UPOWER_DEVICE")
    monitor_pid_out=$!
    monitor_fd_out="$monitor_fd"
}

# sys_monitor_next FD
# Wait for the next change line. Fails when the stream ends: gdbus lost UPower.
sys_monitor_next() {
    local line
    read -r -u "$1" line || {
        err "lost the connection to UPower"
        return "$EXIT_SYSTEM"
    }
}

# sys_monitor_close FD PID
sys_monitor_close() {
    local fd="$1"
    kill "$2" 2>/dev/null || true
    exec {fd}<&-
}

# --- core --------------------------------------------------------------------

# notify_rule RULE STATE PERCENTAGE TIME_TO_EMPTY TIME_TO_FULL
# Send RULE's notification for this battery reading.
notify_rule() {
    local -r rule="$1" state="$2" percent="$3" to_empty="$4" to_full="$5"
    local time notification urgency expire title body
    time="$(format_time "$(time_for "$state" "$to_empty" "$to_full")")"
    notification="$(render_rule "$rule" "$percent" "$time")"
    IFS="$SEP" read -r urgency expire title body <<<"$notification"
    sys_notify "$urgency" "$expire" "$title" "$body"
}

core_show() {
    local rules battery state percent to_empty to_full rule
    rules="$(sys_load_rules)" || return
    battery="$(sys_read_battery)" || return
    read -r state percent to_empty to_full <<<"$battery"
    rule="$(sys_rule_for "$(show_event "$state")" "$rules")" || return
    notify_rule "$rule" "$state" "$percent" "$to_empty" "$to_full"
}

# notify_event EVENT RULES STATE PERCENTAGE TIME_TO_EMPTY TIME_TO_FULL
# Send EVENT's notification. A failure is reported, not fatal: the daemon
# keeps watching.
notify_event() {
    local rule
    rule="$(rule_for "$1" "$2")" || return 0
    notify_rule "$rule" "$3" "$4" "$5" "$6" || true
}

# core_daemon
# Run by battery-notify.service: notify battery events until UPower goes away.
core_daemon() {
    local rules fd pid battery state percent to_empty to_full event
    local prev_state prev_percent
    local -i code=0
    rules="$(sys_load_rules)" || {
        code=$?
        if ((code == EXIT_CONFIG)); then
            sys_notify_config_error || true
        fi
        return "$code"
    }

    # Started before the first reading, so no change can be missed.
    sys_monitor_open fd pid
    # Stopped by a signal (systemctl stop, Ctrl-C), don't leave the monitor
    # behind. The PID is expanded now, on purpose.
    # shellcheck disable=SC2064
    trap "kill $pid 2>/dev/null; exit 143" TERM
    # shellcheck disable=SC2064
    trap "kill $pid 2>/dev/null; exit 130" INT
    if battery="$(sys_read_battery)"; then
        read -r state percent to_empty to_full <<<"$battery"
        while IFS= read -r event; do
            [[ -z "$event" ]] || notify_event "$event" "$rules" "$state" "$percent" "$to_empty" "$to_full"
        done <<<"$(startup_events "$state" "$percent" "$rules")"

        while sys_monitor_next "$fd" || {
            code=$?
            false
        }; do
            prev_state="$state" prev_percent="$percent"
            battery="$(sys_read_battery)" || {
                code=$?
                break
            }
            read -r state percent to_empty to_full <<<"$battery"
            while IFS= read -r event; do
                [[ -z "$event" ]] || notify_event "$event" "$rules" "$state" "$percent" "$to_empty" "$to_full"
            done <<<"$(decide_events "$prev_state" "$prev_percent" "$state" "$percent" "$rules")"
        done
    else
        code=$?
    fi
    sys_monitor_close "$fd" "$pid"
    return "$code"
}

core_status() {
    local battery state percent to_empty to_full
    sys_load_rules >/dev/null || return
    battery="$(sys_read_battery)" || return
    read -r state percent to_empty to_full <<<"$battery"
    format_status "$state" "$percent" "$to_empty" "$to_full"
}

# --- cli ---------------------------------------------------------------------

# usage_error MESSAGE: report a usage error. Returns EXIT_USAGE, so callers can
# write `check || usage_error "..." || return`.
usage_error() {
    err "$1"
    printf "Try 'battery-notify --help' for more information.\n" >&2
    return "$EXIT_USAGE"
}

cli_help() {
    cat <<EOF
Usage: battery-notify show
       battery-notify status
       battery-notify daemon
       battery-notify --help | --version

Battery notifications from UPower.

Commands:
  show     Notify the current battery state.
  status   Print the battery state as key=value lines.
  daemon   Notify battery events; run by battery-notify.service.

Configuration: \$XDG_CONFIG_HOME/battery-notify/config
(~/.config/battery-notify/config); built-in defaults without it.

Exit codes: 0 success, 2 usage error, 3 config error, 4 system error,
            5 no battery.

See 'man battery-notify' for details.
EOF
}

# cli_no_args COMMAND ARG...
# Succeeds if COMMAND was given no arguments.
cli_no_args() {
    local -r command="$1"
    shift
    (($# == 0)) || usage_error "'$command' takes no arguments"
}

main() {
    (($# > 0)) || usage_error "missing command" || return
    local -r command="$1"
    shift
    case "$command" in
    show | status | daemon | --help | --version) ;;
    *) usage_error "unknown command '$command'" || return ;;
    esac
    cli_no_args "$command" "$@" || return
    case "$command" in
    show) core_show ;;
    status) core_status ;;
    daemon) core_daemon ;;
    --help) cli_help ;;
    --version) printf 'battery-notify %s\n' "$VERSION" ;;
    esac
}

# Run only when executed, not when sourced (the tests source this file).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -euo pipefail
    main "$@"
fi
