#!/usr/bin/env bash
#
# battery-notify: battery notifications from UPower.
#
# The design, and the reasons behind it, are in docs/DESIGN.md.
#
# Layers, top to bottom. Each calls only the layers below it.
#   cli     argv → validated values; prints messages; maps results to exit codes
#   core    show, status, daemon
#   system  the only code that runs external commands or reads files; validates
#           what they return and reports its own failures
#   values  pure functions: no I/O besides printing the result
#
# Conventions:
#   - Globals are readonly constants. Everything else is `local`.
#   - Functions return data on stdout and a status as their exit code.
#     Only `main`'s caller exits (and the daemon's signal traps, which can't
#     return anywhere).
#   - Errors propagate explicitly with `|| return`. `set -e` is not relied on
#     inside functions, because Bash disables it in many contexts.
#   - The layer that detects a problem reports it, except the core: it returns
#     a code, and the cli turns it into a message.
#   - Never do arithmetic on an unvalidated string: Bash evaluates it as an
#     expression, which can run commands. Validate with a regex first.
#   - Exception, for speed: a function called in a loop may return its result
#     in a variable named by its first argument (`local -n`), because `$(...)`
#     forks a process. Marked "Returns in OUT" where used.

VERSION="2.0.0"
readonly VERSION

# Exit codes. Each has one meaning across all commands.
readonly EXIT_USAGE=2
readonly EXIT_CONFIG=3
readonly EXIT_SYSTEM=4
readonly EXIT_NO_BATTERY=5

# Separates the fields of a parsed config rule: EVENT URGENCY TIMEOUT TITLE
# MESSAGE. The ASCII unit separator, which the parser refuses in values.
readonly SEP=$'\x1f'

# UPower's combined battery, and the properties read from it, in this order.
readonly UPOWER_DEVICE=/org/freedesktop/UPower/devices/DisplayDevice
readonly UPOWER_PROPERTIES=(IsPresent Type State Percentage TimeToEmpty TimeToFull)

# Used when the user has no config file. Also installed as config.example.
readonly DEFAULT_CONFIG='# battery-notify configuration.
#
# Copy to ~/.config/battery-notify/config and edit; then restart the service:
#   systemctl --user restart battery-notify.service
# The file replaces these defaults entirely. See "man battery-notify".
#
# Each section is an event:
#   [discharging N]   on battery, the level drops to N% or below
#   [charging N]      on AC, the level rises to N% or above
#   [full]            UPower reports "fully charged"
#   [plugged]         the charger is connected
#   [unplugged]       the charger is disconnected
#   [show discharging], [show charging], [show full]
#                     "battery-notify show", by state
# Keys: title (required), message, urgency (low, normal, critical; default
# normal), timeout (milliseconds; default 2000, 0 for critical: stays until
# dismissed). Placeholders: {level} (percentage), {time} (h:mm left).

[show discharging]
title = Battery {level}%
message = {time} remaining

[show charging]
title = Battery {level}% · charging
message = {time} to full

[show full]
title = Battery {level}% · full

[plugged]
title = Charger connected
message = Battery {level}% · {time} to full

[unplugged]
title = Charger disconnected
message = Battery {level}% · {time} remaining

[full]
title = Battery {level}% · full

[discharging 90]
