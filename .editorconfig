root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bash,sh}]
indent_style = space
indent_size = 4

[{src/battery-notify,tests/fakes/*}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.bats]
indent_style = space
indent_size = 4
